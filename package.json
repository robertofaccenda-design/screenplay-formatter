{
  "name": "screenplay-formatter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:story",
    "build:main": "vite build",
    "build:story": "vite build --config genera-la-tua-idea-rome-future-week-2025/vite.config.ts",
